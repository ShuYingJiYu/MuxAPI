# MuxAPI 配置示例 —— 复制为 .env 后按需修改（已设的真实环境变量优先于本文件）
MUXAPI_ADDR=:8080
MUXAPI_DB=muxapi.db
# 管理后台鉴权 token，留空则后台无鉴权，切勿对外暴露
MUXAPI_TOKEN=
MUXAPI_PROBE_INTERVAL=15s
MUXAPI_PROBE_MODEL=gpt-5.5
MUXAPI_PROBE_PATH=/v1/chat/completions
MUXAPI_FAIL_THRESHOLD=3
MUXAPI_COOLDOWN=30s
MUXAPI_MAX_RETRIES=3
MUXAPI_MONITOR_INTERVAL=5m
