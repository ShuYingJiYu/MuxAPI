# MuxAPI 配置示例 —— 复制为 .env 后按需修改（已设的真实环境变量优先于本文件）
MUXAPI_ADDR=:8080
# PostgreSQL 连接串。生产环境建议连接本机加密隧道，不把数据库暴露给应用公网。
MUXAPI_DATABASE_URL=postgres://muxapi:password@127.0.0.1:55432/muxapi?sslmode=disable
# 管理后台鉴权 token，留空则后台无鉴权，切勿对外暴露
MUXAPI_TOKEN=
# 本地查看远程数据库时启用；跳过迁移、后台写任务和所有管理写请求
MUXAPI_READ_ONLY=false
# 熔断、故障切换和请求体限制由管理后台写入数据库；旧环境变量仅在首次迁移时作为初始值。
